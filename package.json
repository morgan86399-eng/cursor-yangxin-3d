    "fetch-buildx": "node tools/fetch-buildx.mjs",
    "test:player": "node tools/test-player.mjs",
    "test:buildings": "node tools/test-buildings.mjs",
    "test:cladding": "node tools/test-cladding.mjs",
    "test:lots": "node tools/test-lots.mjs",
    "test:vectorize": "node tools/test-vectorize.mjs",
    "test:e2e": "node tools/e2e-walk.mjs",
    "test:e2e-ground": "node tools/e2e-ground.mjs",
    "test:e2e-garden": "node tools/e2e-garden.mjs",
    "test:facades": "node tools/test-facades.mjs",
    "test:signs": "node tools/test-sign-detail.mjs",
    "test:street": "node tools/test-street-detail.mjs",
    "test:ground-evidence": "node tools/test-ground-evidence.mjs",
    "test:temple": "node tools/test-temple.mjs",
